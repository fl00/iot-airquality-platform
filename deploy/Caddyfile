# Reverse proxy in front of the dashboard (127.0.0.1:8000).
# Plain HTTP on port 80, intended for a trusted LAN. To expose the dashboard beyond
# it, replace ":80" by a domain name (Caddy then obtains a certificate) and add
# authentication (basic_auth).

:80 {
    encode zstd gzip

    # Live stream (Server-Sent Events): forward each event immediately
    handle /api/v1/stream {
        reverse_proxy 127.0.0.1:8000 {
            flush_interval -1
        }
    }

    handle {
        reverse_proxy 127.0.0.1:8000
    }
}
