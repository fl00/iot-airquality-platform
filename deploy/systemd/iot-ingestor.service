[Unit]
Description=IoT Air Quality ingestor (MQTT to InfluxDB)
After=network.target mosquitto.service influxdb.service
Wants=mosquitto.service influxdb.service

[Service]
Type=simple
User=iot-service
Group=iot-service
WorkingDirectory=/opt/iot-airquality/ingestor
ExecStart=/opt/iot-airquality/ingestor/target/release/iot-airquality-ingestor
Restart=always
RestartSec=3s

# Resource limit (measured: about 5 MB resident at idle)
MemoryMax=40M
CPUQuota=50%

# Linux Security Hardening & Sandboxing
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
NoNewPrivileges=true
CapabilityBoundingSet=
RestrictRealtime=true
RestrictSUIDSGID=true
LockPersonality=true
MemoryDenyWriteExecute=true

# Environment Defaults
Environment="RUST_LOG=info"
Environment="MQTT_BROKER_HOST=127.0.0.1"
Environment="MQTT_BROKER_PORT=1883"
Environment="INFLUXDB_URL=http://127.0.0.1:8086"
Environment="INFLUXDB_ORG=baremetal-iot"
Environment="INFLUXDB_BUCKET=airquality"
# Secrets (INFLUXDB_TOKEN, MQTT_USER, MQTT_PASSWORD): root-owned file, mode 0640
EnvironmentFile=/etc/iot-airquality/env
Environment="METRICS_PORT=9100"

[Install]
WantedBy=multi-user.target
