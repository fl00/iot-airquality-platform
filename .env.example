# Local settings for `make start` / `make run-*`. Copy to .env (git-ignored) and fill in.
# Production uses /etc/iot-airquality/env instead (created by deploy/deploy-baremetal.sh).

# Required. InfluxDB API token with read/write access to the bucket below.
INFLUXDB_TOKEN=

# Optional. Defaults shown.
# INFLUXDB_URL=http://127.0.0.1:8086
# INFLUXDB_ORG=baremetal-iot
# INFLUXDB_BUCKET=airquality
# MQTT_BROKER_HOST=127.0.0.1
# MQTT_BROKER_PORT=1883

# Only when the broker requires authentication (always the case in production).
# MQTT_USER=
# MQTT_PASSWORD=
